# Hetzner gateway. Generate with: openssl rand -hex 32
JARVIS_CORE_TOKEN=replace-with-a-long-random-secret
JARVIS_CORS_ORIGINS=https://jarvis.charlydob.com
JARVIS_CORE_TIMEOUT_SECONDS=180
JARVIS_MAX_AUDIO_BYTES=26214400

# Windows Core
JARVIS_GATEWAY_WS_URL=wss://jarvis.charlydob.com/internal/core/ws
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
JARVIS_WHISPER_LANGUAGE=es
JARVIS_TTS_VOICE=es-ES-AlvaroNeural
JARVIS_TOOL_MODULES=jarvis_core.integrations.bookshell,jarvis_core.integrations.pc,jarvis_core.integrations.web
JARVIS_BOOKSHELL_API_URL=https://api-bookshell.charlydob.com
# Bearer server-to-server requerido por todas las rutas protegidas /jarvis/* de BookShell.
JARVIS_BOOKSHELL_API_TOKEN=
JARVIS_BOOKSHELL_TIMEZONE=Europe/Zurich
JARVIS_WEB_SEARCH_PROVIDER=tavily
# Opcional. Sin clave, web_search no se registra y JARVIS informa que no está disponible.
JARVIS_TAVILY_API_KEY=
JARVIS_VAD_SILENCE_SECONDS=1.5
JARVIS_DATA_DIR=C:/Users/YOUR_USER/.jarvis
JARVIS_LOG_LEVEL=INFO
