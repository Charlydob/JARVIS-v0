# Frontend (the browser uses this URL; leave empty when served through the proxy)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Backend
JARVIS_ENV=development
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
JARVIS_LLM_PROVIDER=mock
JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=llama3.2
JARVIS_LOG_LEVEL=INFO

# Deployment (used by docker-compose)
JARVIS_DOMAIN=jarvis.example.com

