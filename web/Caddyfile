:80 {
  route {
    handle /api/* {
      reverse_proxy gateway:8000
    }

    handle /ws {
      reverse_proxy gateway:8000
    }

    handle /internal/core/ws {
      reverse_proxy gateway:8000
    }

    handle {
      root * /srv
      encode zstd gzip
      @mutable path / /index.html /sw.js /manifest.webmanifest /version.json
      header @mutable Cache-Control "no-cache, no-store, must-revalidate"
      try_files {path} /index.html
      file_server
    }
  }

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
  }
}
